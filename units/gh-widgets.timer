# Hourly widget render. See gh-widgets.service for why it is one unit.
#
# OnUnitActiveSec=1h is measured from the service's last activation (start),
# so the cadence is start-to-start. If the service is still active when the
# timer elapses, systemd leaves it running instead of starting another copy.

[Unit]
Description=Hourly gh-widgets render

[Timer]
OnBootSec=2min
OnUnitActiveSec=1h
Persistent=true
RandomizedDelaySec=2min
Unit=gh-widgets.service

[Install]
WantedBy=timers.target
