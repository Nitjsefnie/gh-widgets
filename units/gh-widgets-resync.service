# gh-widgets — weekly full acquisition and re-blame.
#
# The hourly unit is incremental: it trusts cached immutable data (merged PRs
# keyed by id, per-repo line counts keyed by the default branch's HEAD oid).
# --resync requests a fresh full acquisition and re-blames every external repo.
# The shared unit path retains cache-only PR history from both PR caches,
# unioning those records with the complete live acquisition. Only this unit
# passes --resync; the hourly unit remains incremental.
#
# Same two branches and dependencies as gh-widgets.service; the runner
# waits for every branch even on failure.
#
# Deploy with install.sh --units, never by editing /etc/systemd/system.

[Unit]
Description=Weekly full gh-widgets acquisition and re-blame (retains PR history)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=GH_WIDGETS_GH_USER=Nitjsefnie
Environment=GH_WIDGETS_GH_TOKEN_FILE=/etc/gh-widget.token
Environment=GH_WIDGETS_OUT_DIR=/var/www/nitjsefni.eu/widgets
Environment=GH_WIDGETS_THEME=tokyonight
Environment=GH_WIDGETS_GH_STAR_REPOS=Nitjsefnie/Overflow
# Dropping this makes the blame pass under-count silently, and it bites
# hardest here: --resync re-blames every repo at once.
Environment=GH_WIDGETS_GH_EXTRA_EMAILS=zmatek.peter@gmail.com
Environment=GH_WIDGETS_CACHE_FILE=/var/lib/gh-widgets/cache.json
Environment=GH_WIDGETS_SHARE_DIR=/var/lib/gh-widgets/share/%n
StateDirectory=gh-widgets
# systemd resets this directory's mode at each start, so declare it here.
StateDirectoryMode=0700
# UMask=0077 restricts newly created files and directories to owner access.
UMask=0077

# render.py takes no --cache-file (env only); render-responsiveness.py has no
# --resync at all — it renders from the refreshed impact cache, including
# cache-only PR history retained by the shared acquisition. Re-running it
# after impact IS its resync. Both verified against --help; do not add flags here
# without checking, an unknown flag exits 2 and fails the whole unit.
# Org lookup: see gh-widgets.service.
# Popularity and stars fetch live on every run and have no --resync flag.
ExecStart=/bin/bash /usr/local/bin/run-gh-widgets.sh resync

# Far longer than the hourly unit: a resync re-clones and re-blames every
# external repo rather than only the ones whose HEAD moved.
TimeoutStartSec=10800
Nice=15
StandardOutput=journal
StandardError=journal

# See gh-widgets.service for what these add and how to read them. They matter
# more here than anywhere: a resync re-clones and re-blames EVERY external repo
# rather than only the ones whose HEAD moved, so this is the unit whose disk
# and network cost is worth watching over time.
IOAccounting=yes
IPAccounting=yes
