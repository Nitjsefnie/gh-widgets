# gh-widgets — render every widget SVG, in one pass.
#
# One runner starts two branches and waits for both, including when one fails.
# Lookup -> profile -> impact -> responsiveness -> stars is serial; popularity
# runs independently alongside it.
#
# Order is load-bearing: profile publishes the authored-acquisition share for
# impact, which refreshes the shared impact cache that responsiveness reads.
# Only that chain uses GraphQL, preserving the per-process in-flight cap of 2
# across the unit. Stars also uses GraphQL; popularity uses REST and git.
#
# A unit has ONE environment block but five renderers using THREE caches, so the
# split is deliberate: CACHE_FILE= below is the profile cache, and the two
# renderers that share the impact cache get it as an explicit --cache-file flag
# (the flag overrides the env var). render.py has NO --cache-file flag at all —
# it reads CACHE_FILE only — which is why the env var carries the profile cache
# rather than the impact one. Verify with `--help` before changing either.
#
# Deploy with install.sh --units, never by editing /etc/systemd/system.

[Unit]
Description=Render all gh-widgets SVGs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=GH_USER=Nitjsefnie
Environment=GH_TOKEN_FILE=/etc/gh-widget.token
Environment=OUT_DIR=/var/www/nitjsefni.eu/widgets
Environment=THEME=tokyonight
Environment=GH_STAR_REPOS=Nitjsefnie/Overflow
# Line ownership is an exact match against the account's GitHub noreply
# addresses; the workstation address never appears as one, so without this the
# blame pass silently under-counts. Profile fetches identity for the same-run
# share that impact and responsiveness reuse; standalone runs fetch it live.
Environment=GH_EXTRA_EMAILS=zmatek.peter@gmail.com
Environment=CACHE_FILE=/var/lib/gh-widgets/cache.json
Environment=GH_WIDGETS_SHARE_DIR=/var/lib/gh-widgets/share/%n
StateDirectory=gh-widgets
# systemd resets this directory's mode at each start, so declare it here.
StateDirectoryMode=0700
# UMask=0077 restricts newly created files and directories to owner access.
UMask=0077

# render.py counts these orgs' public, non-fork repos into the stats card;
# private organization repos never reach the SVG. The list is every org the
# token's account belongs to, looked up at each run (read:org also returns
# private memberships), so joining or leaving an org needs no edit here.
# A failed lookup fails the unit rather than rendering an under-count.
# The runner retains the opt-in orgs-lookup timing journal line.
ExecStart=/bin/bash /usr/local/bin/run-gh-widgets.sh normal

# Covers all five renderers. The blame pass dominates: it re-clones and
# re-blames every external repo whose default-branch HEAD moved.
TimeoutStartSec=5400
Nice=12
StandardOutput=journal
StandardError=journal

# Accounting — these add `IO:` and `IP:` lines to `systemctl status`, next to
# the `CPU:` and `Mem peak:` lines systemd already shows (CPU and memory
# accounting are on by default on this box, I/O and IP are not).
#
# Both are worth having here: the blame pass full-clones every external repo
# whose HEAD moved, so this unit is unusually heavy on both disk and network
# for something that renders every card.
#
# Caveats, so the numbers are not over-read:
#   IOAccounting counts actual block-device I/O via the cgroup io controller,
#   so reads served from page cache do not appear — the read figure understates
#   bytes touched, while the write figure is real.
#   IPAccounting counts AF_INET/AF_INET6 socket traffic via eBPF; it does not
#   see traffic of processes that leave the cgroup.
IOAccounting=yes
IPAccounting=yes
